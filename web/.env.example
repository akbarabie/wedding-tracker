# Database Password Supabase
PASSWORD_DATABASE=XXXXX

# Alamat project Supabase, contoh: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=XXXX

# Kunci publishable (sb_publishable_...), aman untuk browser karena tunduk pada RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=XXXX

# Digunakan untuk password Emails di SMPT Supabase ketika mengirim email dari Supabase
SMTP_BREVO=XXXX

# Secret Key Supabase, jangan dibagikan ke publik karena memiliki akses penuh ke database
SUPABASE_SECRET_KEY=XXXX

# Digunakan untuk Turntile Cloudflare, untuk public
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tempel_site_key_di_sini

# Digunakan untuk Turntile Cloudflare, untuk private
TURNSTILE_SECRET_KEY=tempel_secret_key_di_sini